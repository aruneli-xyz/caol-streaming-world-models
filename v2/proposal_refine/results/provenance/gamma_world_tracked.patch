+    # ------------------------------------------------------------------
+    # SafeSWM / hazloc instrumentation (local patch): pooled per-block DiT
+    # activations for layerwise hazard-emergence probing. Enable with
+    # SAFESWM_DUMP_ACTS="0,7,14,21,27" (block indices). Each hooked block
+    # appends a (mean, std) token-pooled vector per forward call; the
+    # caller resets/collects via reset_act_records()/act_records.
+    def setup_activation_hooks(self) -> None:
+        import os as _os
+
+        spec = _os.environ.get("SAFESWM_DUMP_ACTS")
+        if not spec:
+            return
+        blocks = self.model.net.blocks
+        self.act_hook_indices = [int(s) for s in spec.split(",") if s.strip() != ""]
+        self.act_records = {i: [] for i in self.act_hook_indices}
+
+        def make_hook(idx: int):
+            def hook(_module, _inp, out):
+                t = out[0] if isinstance(out, tuple) else out
+                t = t.detach().float()
+                flat = t.reshape(-1, t.shape[-1])  # tokens x channels
+                pooled = torch.cat([flat.mean(0), flat.std(0)]).to("cpu", dtype=torch.float16)
+                self.act_records[idx].append(pooled)
+            return hook
+
+        for i in self.act_hook_indices:
+            blocks[i].register_forward_hook(make_hook(i))
+        log.info(f"[hazloc] activation hooks on blocks {self.act_hook_indices} "
+                 f"(of {len(blocks)})")
+
+    def reset_act_records(self) -> None:
+        if hasattr(self, "act_records"):
+            for k in self.act_records:
+                self.act_records[k] = []
+
     def cleanup(self) -> None:
 
